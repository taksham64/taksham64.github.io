    <script>
        // Array of full month names
        const MONTH_NAMES = [
            "January", "February", "March", "April", "May", "June", 
            "July", "August", "September", "October", "November", "December"
        ];

        // Object containing default days mapping for standard non-leap years
        const DAYS_IN_MONTH = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

        // Core UI DOM elements 
        const inputEmpName = document.getElementById('empName');
        const inputDesignation = document.getElementById('empDesignation');
        const inputDepartment = document.getElementById('empDepartment');
        const selectMonth = document.getElementById('payrollMonth');
        const inputYear = document.getElementById('payrollYear');
        const inputPayPeriodStart = document.getElementById('payPeriodStart');
        const inputPayPeriodEnd = document.getElementById('payPeriodEnd');
        const inputBaseSalary = document.getElementById('baseSalary');
        const inputUnpaidLeaves = document.getElementById('unpaidLeaves');
        const inputOtherDeductions = document.getElementById('otherDeductions');

        // Document preview DOM elements to be updated dynamically
        const slipPeriodHeader = document.getElementById('slipPeriodHeader');
        const slipName = document.getElementById('slipName');
        const slipDesignation = document.getElementById('slipDesignation');
        const slipDepartment = document.getElementById('slipDepartment');
        const slipPayPeriod = document.getElementById('slipPayPeriod');
        const slipTotalDays = document.getElementById('slipTotalDays');
        const slipActiveDays = document.getElementById('slipActiveDays');
        const slipLeaves = document.getElementById('slipLeaves');
        const slipBaseSalary = document.getElementById('slipBaseSalary');
        const slipEarningsSubtext = document.getElementById('slipEarningsSubtext');
        const slipLeaveBreakdownLabel = document.getElementById('slipLeaveBreakdownLabel');
        const slipLeaveDeduction = document.getElementById('slipLeaveDeduction');
        const slipOtherDeductions = document.getElementById('slipOtherDeductions');
        const slipGrossEarnings = document.getElementById('slipGrossEarnings');
        const slipTotalDeductions = document.getElementById('slipTotalDeductions');
        const slipNetPay = document.getElementById('slipNetPay');
        const slipNetInWords = document.getElementById('slipNetInWords');
        const sigEmployeeName = document.getElementById('sigEmployeeName');

        // Info block badges
        const infoTotalMonthDays = document.getElementById('infoTotalMonthDays');
        const infoActiveDays = document.getElementById('infoActiveDays');

        // Event listener setup for live visual update
        const liveInputs = [
            inputEmpName, inputDesignation, inputDepartment, selectMonth, 
            inputYear, inputPayPeriodStart, inputPayPeriodEnd, inputBaseSalary, 
            inputUnpaidLeaves, inputOtherDeductions
        ];

        liveInputs.forEach(input => {
            input.addEventListener('input', updateSalarySlip);
        });

        // Trigger dynamic change on month or year to automatically calculate calendar properties
        selectMonth.addEventListener('change', autoSetCalendarDetails);
        inputYear.addEventListener('change', autoSetCalendarDetails);

        /**
         * Checks leap year and returns appropriate days count.
         */
        function getDaysInMonth(monthIndex, year) {
            if (monthIndex === 1) { // February check
                return ((year % 4 === 0 && year % 100 !== 0) || year % 400 === 0) ? 29 : 28;
            }
            return DAYS_IN_MONTH[monthIndex];
        }

        /**
         * Formats a date as YYYY-MM-DD for date-picker value fields
         */
        function formatYYYYMMDD(year, monthIndex, day) {
            const mm = String(monthIndex + 1).padStart(2, '0');
            const dd = String(day).padStart(2, '0');
            return `${year}-${mm}-${dd}`;
        }

        /**
         * Formats YYYY-MM-DD back to professional readable format
         */
        function formatToReadableDate(dateString) {
            if (!dateString) return "";
            const d = new Date(dateString);
            if (isNaN(d)) return "";
            const day = d.getDate();
            const month = MONTH_NAMES[d.getMonth()];
            return `${month} ${day}`;
        }

        /**
         * Automatically sets 'Start Date' and 'End Date' to match the active full month default
         */
        function autoSetCalendarDetails() {
            const month = parseInt(selectMonth.value);
            const year = parseInt(inputYear.value) || new Date().getFullYear();
            const daysCount = getDaysInMonth(month, year);

            inputPayPeriodStart.value = formatYYYYMMDD(year, month, 1);
            inputPayPeriodEnd.value = formatYYYYMMDD(year, month, daysCount);
            
            updateSalarySlip();
        }

        // Helper to format raw integers to standard Indian Currency Format
        function formatRupee(amount) {
            return new Intl.NumberFormat('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }).format(amount);
        }

        /**
         * Primary orchestrator function calculating daily breakdown, totals and conversions
         */
        function updateSalarySlip() {
            // Read UI parameter state
            const employeeName = inputEmpName.value || "Bobby";
            const designation = inputDesignation.value || "Stylist";
            const department = inputDepartment.value || "Operations";
            const monthIndex = parseInt(selectMonth.value);
            const year = parseInt(inputYear.value) || new Date().getFullYear();
            const totalDaysInMonth = getDaysInMonth(monthIndex, year);
            
            // Period dates parsing
            const startDateVal = inputPayPeriodStart.value;
            const endDateVal = inputPayPeriodEnd.value;
            
            let daysInActivePeriod = totalDaysInMonth;
            if (startDateVal && endDateVal) {
                const sDate = new Date(startDateVal);
                const eDate = new Date(endDateVal);
                if (!isNaN(sDate) && !isNaN(eDate) && eDate >= sDate) {
                    const diffTime = Math.abs(eDate - sDate);
                    daysInActivePeriod = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                }
            }

            const baseMonthlySalary = parseFloat(inputBaseSalary.value) || 0;
            const unpaidLeavesCount = parseFloat(inputUnpaidLeaves.value) || 0;
            const otherDeductionsVal = parseFloat(inputOtherDeductions.value) || 0;

            // Math execution
            // Calculate daily rate based on total days in month
            const dailyRate = baseMonthlySalary / totalDaysInMonth;
            
            // Calculate Earned base salary prorated for the period
            const earnedBasicSalary = Math.round((dailyRate * daysInActivePeriod) * 100) / 100;

            // Ensure unpaid leaves don't exceed active period days
            const unpaidDays = Math.min(unpaidLeavesCount, daysInActivePeriod);
            const leaveDeductionTotal = Math.round((dailyRate * unpaidDays) * 100) / 100;
            
            const totalDeductionsSum = leaveDeductionTotal + otherDeductionsVal;
            const netTakeHomePay = Math.max(0, earnedBasicSalary - totalDeductionsSum);

            // Populate info badges
            infoTotalMonthDays.innerText = totalDaysInMonth;
            infoActiveDays.innerText = daysInActivePeriod;

            // Populate preview fields 
            slipPeriodHeader.innerText = `${MONTH_NAMES[monthIndex]} ${year}`;
            slipName.innerText = employeeName;
            sigEmployeeName.innerText = employeeName;
            slipDesignation.innerText = designation;
            slipDepartment.innerText = department;
            
            // Render specific readable range (e.g. "June 15 - June 30")
            const readableStart = formatToReadableDate(startDateVal);
            const readableEnd = formatToReadableDate(endDateVal);
            slipPayPeriod.innerText = (readableStart && readableEnd) ? `${readableStart} - ${readableEnd}` : `${MONTH_NAMES[monthIndex]} 1 - ${MONTH_NAMES[monthIndex]} ${totalDaysInMonth}`;
            
            slipTotalDays.innerText = `${totalDaysInMonth} Days`;
            slipActiveDays.innerText = `${daysInActivePeriod} Days`;
            slipLeaves.innerText = `${unpaidDays} ${unpaidDays === 1 ? 'Day' : 'Days'} (LWP)`;

            // Populate numerical breakdown in Ledger Table
            slipBaseSalary.innerText = formatRupee(earnedBasicSalary);
            
            // Label customization if they are a mid-month joiner (partial month work period)
            if (daysInActivePeriod < totalDaysInMonth) {
                slipEarningsSubtext.innerText = `Prorated for ${daysInActivePeriod} of ${totalDaysInMonth} Days (Monthly Rate: ₹${formatRupee(baseMonthlySalary)})`;
            } else {
                slipEarningsSubtext.innerText = `Full month salary (30/31 days)`;
            }

            slipLeaveBreakdownLabel.innerText = `Leave Without Pay (${unpaidDays} ${unpaidDays === 1 ? 'Day' : 'Days'})`;
            slipLeaveDeduction.innerText = formatRupee(leaveDeductionTotal);
            slipOtherDeductions.innerText = formatRupee(otherDeductionsVal);
            slipGrossEarnings.innerText = `₹${formatRupee(earnedBasicSalary)}`;
            slipTotalDeductions.innerText = `₹${formatRupee(totalDeductionsSum)}`;
            slipNetPay.innerText = `₹${formatRupee(netTakeHomePay)}`;

            // Populate Words conversion
            slipNetInWords.innerText = convertNumberToWords(Math.round(netTakeHomePay));
        }

        /**
         * Decodes standard digit values to descriptive English equivalents in Indian Style (Lakhs/Crores)
         */
        function convertNumberToWords(amount) {
            const singleWords = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
            const tensWords = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
            
            if (amount === 0) return "Zero Rupees Only";
            
            let num = Math.floor(amount);
            let words = "";

            if (num >= 10000000) { // Crores
                words += convertChunk(Math.floor(num / 10000000)) + " Crore ";
                num %= 10000000;
            }
            if (num >= 100000) { // Lakhs
                words += convertChunk(Math.floor(num / 100000)) + " Lakh ";
                num %= 100000;
            }
            if (num >= 1000) { // Thousands
                words += convertChunk(Math.floor(num / 1000)) + " Thousand ";
                num %= 1000;
            }
            if (num >= 100) { // Hundreds
                words += convertChunk(Math.floor(num / 100)) + " Hundred ";
                num %= 100;
            }
            if (num > 0) {
                if (words !== "") words += "and ";
                words += convertChunk(num);
            }

            function convertChunk(n) {
                if (n < 20) return singleWords[n];
                const tens = Math.floor(n / 10);
                const singles = n % 10;
                return tensWords[tens] + (singles !== 0 ? " " + singleWords[singles] : "");
            }

            return (words.trim() + " Rupees Only").replace(/\s+/g, ' ');
        }

        // Initial launch configuration on document load
        window.onload = function() {
            // Programmatically set calendar defaults on initial load (June 2026)
            autoSetCalendarDetails();
        }
    </script>
